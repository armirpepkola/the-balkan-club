---
const currentYear = new Date().getFullYear();
---

<footer class="bg-obsidian text-white border-t border-white/5 pt-20 pb-10">
  <div
    class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-24 items-end"
  >
    <!-- Brand Pillar (1/3) -->
    <!-- Added text-center md:text-left to handle mobile alignment -->
    <div class="md:col-span-1 space-y-6 text-center md:text-left">
      <h2
        class="text-3xl sm:text-5xl md:text-7xl font-serif tracking-tighter whitespace-nowrap"
      >
        THE BALKAN<br /><span class="text-gradient-gold">CLUB</span>
      </h2>
      <!-- Added mx-auto to ensure paragraph stays centered on mobile -->
      <!-- <p class="text-gray-400 max-w-sm leading-relaxed mx-auto md:mx-0">
        The definitive sanctuary for the bold. Redefining the nocturnal
        experience in Northampton.
      </p> -->
    </div>

    <!-- Booking Section (2/3) -->
    <!-- Changed items-start to items-center for mobile centering -->
    <div
      class="md:col-span-2 flex flex-col items-center md:items-end justify-end relative mb-12"
    >
      <!-- Subtle Brand Texture -->
      <span
        class="absolute right-0 top-0 text-[120px] lg:text-[180px] font-serif opacity-5 select-none pointer-events-none"
        >B</span
      >

      <!-- Added text-center for mobile consistency -->
      <div class="text-center md:text-right mb-6">
        <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-2">
          Walk-ins Welcome*
        </p>
        <a href="tel:+4407448014594" target="_blank">
          <button
            id="vip-modal-trigger"
            aria-haspopup="dialog"
            aria-expanded="false"
            class="book-vip-trigger bg-crimson hover:bg-red-900 text-white font-sans uppercase tracking-widest text-sm px-12 py-5 rounded-sm transition-all duration-300 border border-crimson hover:border-gold shadow-[0_0_15px_rgba(139,0,0,0.4)] hover:shadow-[0_0_20px_rgba(212,175,55,0.4)] cursor-pointer"
          >
            Reserve Your Table
          </button>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar remains unchanged as it already handles alignment well -->
  <div
    class="max-w-7xl mx-auto px-6 mt-20 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center text-[10px] uppercase tracking-[0.2em] text-gray-500 gap-6"
  >
    <p>&copy; {currentYear} The Balkan Club. All Rights Reserved.</p>
    <span>Northampton, UK</span>
  </div>

  <!-- Accessible Modal -->
  <dialog
    id="booking-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
    class="fixed inset-0 m-auto bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm open:animate-fade-in-up"
  >
    <div
      class="glass-panel p-10 max-w-md w-[90vw] mx-auto text-center border border-gold-metallic/30 relative"
    >
      <button
        id="close-modal-btn"
        aria-label="Close modal"
        class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M6 18L18 6M6 6l12 12"></path></svg
        >
      </button>

      <h3
        id="modal-title"
        class="text-2xl font-serif text-white uppercase tracking-widest mb-4 mt-2"
      >
        VIP <span class="text-gradient-gold">Reservations</span>
      </h3>
      <p class="text-gray-300 font-sans font-light text-sm mb-8">
        Our digital booking portal is currently undergoing an exclusive upgrade.
        To secure your table tonight, please contact our concierge directly.
      </p>

      <a
        href="mailto:concierge@thebalkanclub.co.uk"
        class="inline-block w-full px-6 py-4 bg-transparent border border-gold-metallic text-gold-light hover:bg-gold-metallic/10 font-medium tracking-widest transition-colors duration-300 uppercase text-sm"
      >
        Email Concierge
      </a>
    </div>
  </dialog>
</footer>
