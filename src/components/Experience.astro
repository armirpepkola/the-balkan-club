---
// src/components/Experience.astro
---

<section class="relative py-24 px-4 bg-obsidian border-t border-white/5 z-10">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h2
        class="text-3xl md:text-5xl font-display text-white mb-4 tracking-wide uppercase"
      >
        An Unforgettable Experience
      </h2>
      <div class="w-16 h-0.5 bg-gold mx-auto mb-6"></div>
      <p class="text-gray-400 font-sans max-w-2xl mx-auto text-lg font-light">
        Every detail is meticulously curated. From the moment you step through
        our velvet ropes, you enter a world of unparalleled sophistication.
      </p>
    </div>

    <!-- Value Proposition Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        [
          {
            title: "Premium VIP",
            desc: "Exclusive tables, dedicated bottle service, and absolute discretion for our most discerning guests.",
          },
          {
            title: "Signature Cocktails",
            desc: "Crafted by master mixologists using rare, premium spirits and avant-garde techniques.",
          },
          {
            title: "International DJs",
            desc: "Curated, high-energy soundscapes from the world's most sought-after electronic artists.",
          },
          {
            title: "Sophisticated Lounges",
            desc: "Intimate enclaves adorned with dark velvet, leopard motifs, and crystal accents.",
          },
        ].map((item) => (
          <div class="bg-glass p-8 rounded-sm hover:-translate-y-2 transition-transform duration-300 border border-white/5 hover:border-gold/40 group animate-fade-in-up">
            <h3 class="text-xl font-display text-gold mb-3 group-hover:text-white transition-colors">
              {item.title}
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed font-sans">
              {item.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
