---
// src/components/Experience.astro

const features = [
  {
    title: "Premium VIP",
    desc: "Exclusive booth seating with dedicated bottle service and personal hosting for the ultimate elite experience.",
  },
  {
    title: "Signature Cocktails",
    desc: "Artisanal beverages crafted by our master mixologists, blending premium spirits with exotic ingredients.",
  },
  {
    title: "International DJs",
    desc: "State-of-the-art acoustic sound systems paired with world-class talent to keep the energy unmatched.",
  },
  {
    title: "Sophisticated Spaces",
    desc: "Intimately designed enclaves perfect for private conversation, high-end networking, and connection.",
  },
];
---

<section
  id="experience"
  class="relative py-24 px-4 bg-obsidian border-t border-white/5 z-10"
>
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl text-white uppercase mb-6">
        An Unforgettable <span class="text-gradient-gold">Experience</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto font-light text-lg">
        Step into a world where every detail is meticulously curated to elevate
        your night.
      </p>
    </div>

    <!-- Value Proposition Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        features.map((item) => (
          <div class="glass-panel p-8 text-center group hover:-translate-y-2 transition-all duration-300 border-white/10 hover:border-gold-metallic animate-fade-in-up">
            <h3 class="text-xl text-gold-metallic mb-4 uppercase tracking-wider group-hover:text-white transition-colors duration-300">
              {item.title}
            </h3>
            <p class="text-gray-400 text-sm font-light leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
