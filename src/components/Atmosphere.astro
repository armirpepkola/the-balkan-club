---
// src/components/Atmosphere.astro
---

<section id="atmosphere" class="py-24 px-4 bg-obsidian">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 animate-fade-in-up">
      <h2
        class="text-3xl md:text-5xl font-display text-white mb-4 uppercase tracking-wide"
      >
        The Atmosphere
      </h2>
      <div class="w-16 h-0.5 bg-gold mx-auto"></div>
    </div>

    <!-- Asymmetrical Grid for High-End Aesthetic -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 auto-rows-62.5">
      <!-- Image 1 -->
      <div
        class="md:col-span-2 md:row-span-2 relative group overflow-hidden border border-white/5"
      >
        <div
          class="absolute inset-0 bg-linear-to-tr from-[#2a0000] to-black opacity-80 transition-transform group-hover:scale-105 duration-700"
        >
        </div>
        <div
          class="absolute inset-0 flex items-center justify-center text-gold/20 font-display text-2xl"
        >
          Visual 01
        </div>
      </div>
      <!-- Image 2 -->
      <div
        class="md:col-span-2 relative group overflow-hidden border border-white/5"
      >
        <div
          class="absolute inset-0 bg-linear-to-bl from-obsidian to-[#2a0000] opacity-80 transition-transform group-hover:scale-105 duration-700"
        >
        </div>
        <div
          class="absolute inset-0 flex items-center justify-center text-gold/20 font-display text-2xl"
        >
          Visual 02
        </div>
      </div>
      <!-- Image 3 -->
      <div class="relative group overflow-hidden border border-white/5">
        <div
          class="absolute inset-0 bg-[#1a0000] opacity-80 transition-transform group-hover:scale-105 duration-700"
        >
        </div>
        <div
          class="absolute inset-0 flex items-center justify-center text-gold/20 font-display text-2xl"
        >
          Visual 03
        </div>
      </div>
      <!-- Image 4 -->
      <div class="relative group overflow-hidden border border-white/5">
        <div
          class="absolute inset-0 bg-black opacity-80 transition-transform group-hover:scale-105 duration-700"
        >
        </div>
        <div
          class="absolute inset-0 flex items-center justify-center text-gold/20 font-display text-2xl"
        >
          Visual 04
        </div>
      </div>
    </div>
  </div>
</section>
