---
// src/components/Atmosphere.astro
import { Image } from "astro:assets";
import mainFloorImg from "../assets/images/F_IMG_1038.jpg";
import chandelierImg from "../assets/images/F_IMG_1475.jpg";
import leopardTexture from "../assets/images/DSC06164.jpg";
import fourthImg from "../assets/images/F_DSC06567.jpg";
---

<section
  id="atmosphere"
  class="py-32 px-4 bg-obsidian relative overflow-hidden border-t border-white/5"
>
  <!-- Ambient background glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 bg-crimson-dark/10 rounded-full blur-[150px] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Minimalist Header -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6"
    >
      <div>
        <span
          class="text-xs uppercase tracking-[0.3em] text-gold-metallic block mb-3"
          >Visual Narrative</span
        >
        <h2
          class="text-4xl md:text-6xl font-serif text-white uppercase tracking-wider"
        >
          The <span class="text-gradient-gold">Atmosphere</span>
        </h2>
      </div>
    </div>

    <!-- 4-Image Asymmetric Bento Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-75 md:auto-rows-85"
    >
      <!-- Card 1: Wide Feature (Landscape Recommended) -->
      <div
        class="md:col-span-2 relative group rounded-sm overflow-hidden border border-gold-metallic/20 shadow-2xl bg-black"
      >
        <Image
          src={mainFloorImg}
          alt="The Balkan Club Main Floor"
          loading="lazy"
          widths={[600, 1000, 1400]}
          sizes="(max-width: 768px) 100vw, 66vw"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <!-- Dedicated Text Overlay Gradient -->
        <div
          class="absolute inset-x-0 bottom-0 pt-20 pb-8 px-8 bg-linear-to-t from-black/95 via-black/60 to-transparent z-20"
        >
          <span
            class="text-[10px] font-sans uppercase tracking-[0.3em] text-gold-metallic block mb-2"
            >01 / Energy</span
          >
          <h3 class="text-2xl md:text-3xl font-serif text-white tracking-wide">
            Main Floor Experience
          </h3>
        </div>
      </div>

      <!-- Card 2: Single Column Vertical (Portrait/Square Recommended) -->
      <div
        class="relative group rounded-sm overflow-hidden border border-white/10 shadow-2xl bg-black"
      >
        <Image
          src={chandelierImg}
          alt="Bespoke Crystal Chandeliers"
          loading="lazy"
          widths={[400, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <!-- Dedicated Text Overlay Gradient -->
        <div
          class="absolute inset-x-0 bottom-0 pt-20 pb-8 px-8 bg-linear-to-t from-black/95 via-black/60 to-transparent z-20"
        >
          <span
            class="text-[10px] font-sans uppercase tracking-[0.3em] text-gold-metallic block mb-2"
            >02 / Exclusivity</span
          >
          <h3 class="text-2xl font-serif text-white tracking-wide">
            The VIP Enclaves
          </h3>
        </div>
      </div>

      <!-- Card 3: Single Column Vertical (Portrait/Square Recommended) -->
      <div
        class="relative group rounded-sm overflow-hidden border border-white/10 shadow-2xl bg-black"
      >
        <Image
          src={leopardTexture}
          alt="Exclusive Interior Texture"
          loading="lazy"
          widths={[400, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <!-- Dedicated Text Overlay Gradient -->
        <div
          class="absolute inset-x-0 bottom-0 pt-20 pb-8 px-8 bg-linear-to-t from-black/95 via-black/60 to-transparent z-20"
        >
          <span
            class="text-[10px] font-sans uppercase tracking-[0.3em] text-gold-metallic block mb-2"
            >03 / Artistry</span
          >
          <h3 class="text-2xl font-serif text-white tracking-wide">
            Crafting Essence
          </h3>
        </div>
      </div>

      <!-- Card 4: Wide Feature (Landscape Recommended) -->
      <div
        class="md:col-span-2 relative group rounded-sm overflow-hidden border border-white/10 shadow-2xl bg-black"
      >
        <Image
          src={fourthImg}
          alt="VIP Enclave Atmosphere"
          loading="lazy"
          widths={[600, 1000, 1400]}
          sizes="(max-width: 768px) 100vw, 66vw"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <!-- Dedicated Text Overlay Gradient -->
        <div
          class="absolute inset-x-0 bottom-0 pt-20 pb-8 px-8 bg-linear-to-t from-black/95 via-black/60 to-transparent z-20"
        >
          <span
            class="text-[10px] font-sans uppercase tracking-[0.3em] text-gold-metallic block mb-2"
            >04 / MUSIC</span
          >
          <h3 class="text-2xl md:text-3xl font-serif text-white tracking-wide">
            The DJ Deck
          </h3>
        </div>
      </div>
    </div>
  </div>
</section>
