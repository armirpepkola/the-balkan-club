---
import { Image } from "astro:assets";
import heroBg from "../assets/images/DSC06334.jpg";
---

<section
  class="relative h-screen w-full flex items-center justify-center overflow-hidden bg-obsidian"
>
  <!-- Background Layer with Explicit Container Bounds -->
  <div class="absolute inset-0 z-0 scale-105 animate-slow-zoom w-full h-full">
    <Image
      src={heroBg}
      alt="The Balkan Club Main Floor"
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      widths={[640, 1024, 1536, 2048]}
      sizes="100vw"
    />
    <div
      class="absolute inset-0 bg-linear-to-b from-black/60 via-black/20 to-obsidian"
    >
    </div>
  </div>

  <!-- Content Layer -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <div class="overflow-hidden mb-6">
      <h1
        class="text-7xl md:text-9xl font-serif text-white uppercase tracking-tighter leading-[0.85] animate-reveal"
      >
        The Balkan <br /><span class="text-gradient-gold">Club</span>
      </h1>
    </div>

    <div class="overflow-hidden mb-12">
      <p
        class="text-lg md:text-xl text-gray-300 font-light italic tracking-widest animate-reveal-delay"
      >
        no ordinary weekend.
      </p>
    </div>
  </div>
</section>
