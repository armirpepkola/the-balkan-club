---
import { Image } from "astro:assets";
import logoImg from "../assets/images/logo.png";
---

<nav
  id="navbar"
  class="fixed top-6 left-1/2 -translate-x-1/2 z-50 glass-panel rounded-full px-8 py-3 flex items-center gap-8 border border-white/10 shadow-2xl transition-all duration-500 ease-in-out group"
>
  <!-- Logo with dynamic size -->
  <a href="/" class="flex items-center shrink-0 transition-all duration-500">
    <Image
      id="nav-logo"
      src={logoImg}
      alt="The Balkan Club Logo"
      width={160}
      height={49}
      class="h-10 w-auto object-contain transition-all duration-500"
      loading="eager"
    />
  </a>

  <!-- Desktop Links -->
  <div
    class="hidden md:flex items-center gap-8 text-xs font-sans uppercase tracking-widest text-gray-400"
  >
    <a
      href="#logistics"
      class="hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.5)] transition-all duration-300"
      >Details</a
    >
    <a href="#atmosphere" class="hover:text-white transition-colors"
      >Atmosphere</a
    >
    <!-- <a href="#experience" class="hover:text-white transition-colors"
      >Experience</a
    > -->
    <a href="#spaces" class="hover:text-white transition-colors">Spaces</a>
  </div>
</nav>

<script>
  const nav = document.getElementById("navbar");
  const logo = document.getElementById("nav-logo");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      // Scrolled state: Shrink nav and logo
      nav?.classList.replace("py-3", "py-2");
      nav?.classList.replace("px-8", "px-6");
      logo?.classList.replace("h-10", "h-7");
    } else {
      // Top state: Back to original
      nav?.classList.replace("py-2", "py-3");
      nav?.classList.replace("px-6", "px-8");
      logo?.classList.replace("h-7", "h-10");
    }
  });
</script>
