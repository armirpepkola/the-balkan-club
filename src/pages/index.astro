---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Atmosphere from "../components/Atmosphere.astro";
import SignatureSpaces from "../components/SignatureSpaces";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Logistics from "../components/Logistics.astro";

// Import your existing images to pass down to the React island
import grandBarImg from "../assets/images/F_IMG_1039.jpg";
import vipLoungeImg from "../assets/images/DSC06114_C.jpg";
import boilerRoomImg from "../assets/images/DSC06111.jpg";
import mainClubImg from "../assets/images/F_IMG_1085.jpg";
---

<Layout
  title="Exclusive Nightlife"
  description="The Balkan Club in Northampton. Where luxury meets nightlife. Where every night becomes a story."
>
  <Navbar />
  <main class="bg-obsidian flex flex-col w-full">
    <Hero />
    <Logistics />
    <Atmosphere />
    <!-- Note: React components will use Astro's client directives to manage JS payloads -->
    <SignatureSpaces
      client:visible
      grandBarImage={grandBarImg.src}
      vipLoungeImage={vipLoungeImg.src}
      boilerRoomImage={boilerRoomImg.src}
      mainClubImage={mainClubImg.src}
    />
    <Experience />
  </main>

  <Footer />
</Layout>
