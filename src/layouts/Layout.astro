---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Where luxury meets nightlife. Where every night becomes a story.",
} = Astro.props;

// Phase 1: Pre-baked Local SEO Schema for Northampton
const schema = {
  "@context": "https://schema.org",
  "@type": "NightClub",
  name: "The Balkan Club",
  image: "https://thebalkanclub.co.uk/og-image.webp", // Placeholder until deployment
  "@id": "https://thebalkanclub.co.uk",
  url: "https://thebalkanclub.co.uk",
  telephone: "+44 1604 000000", // TODO: Client to provide
  address: {
    "@type": "PostalAddress",
    streetAddress: "TBD", // TODO: Client to provide
    addressLocality: "Northampton",
    postalCode: "NN1", // TODO: Client to provide full postcode
    addressCountry: "GB",
  },
  priceRange: "$$$",
  description: description,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | The Balkan Club</title>
    <meta name="description" content={description} />

    <!-- Preloading High-End Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Native Astro 7 View Transitions for SPA feel -->
    <ClientRouter />

    <!-- Local SEO Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body
    class="bg-obsidian text-gray-200 antialiased selection:bg-crimson selection:text-white min-h-screen flex flex-col"
  >
    <slot />
  </body>
</html>
